# High sensitivity - for demonstrations.
#
# Detectors fire early so an attack is obvious within a second or two. Expect
# more false positives: the simulator's normal bus load (~285 msg/s) sits much
# closer to the flood threshold here.

FLOOD_THRESHOLD=350
FLOOD_SUSPICIOUS_RATIO=0.6
FLOOD_CRITICAL_MULTIPLIER=1.5
PER_ID_FLOOD_THRESHOLD=150

FAKE_SPEED_THRESHOLD=150
FAKE_SPEED_SUSPICIOUS_THRESHOLD=90
FAKE_SPEED_MAX_ACCELERATION=10

ID_ANOMALY_ESCALATION_COUNT=2
ID_ANOMALY_WINDOW_SECONDS=10

FREQUENCY_FAST_RATIO=1.8
FREQUENCY_ATTACK_RATIO=3.0
FREQUENCY_SLOW_RATIO=2.0
FREQUENCY_MIN_SAMPLES=8

# Report repeats more often so the alert feed stays busy during a demo.
DETECTION_EVENT_COOLDOWN_SECONDS=1
