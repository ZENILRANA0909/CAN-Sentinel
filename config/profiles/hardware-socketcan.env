# Real CAN hardware via SocketCAN (Linux).
#
# Prerequisites:
#   * A SocketCAN-capable adapter, or a virtual bus for testing:
#       scripts/setup_vcan.sh
#   * The simulator does not run in this mode - traffic comes from the bus.
#
# The identifier allowlist below is the one the built-in simulator uses. Replace
# it with your own vehicle's identifiers, or every frame will be reported as an
# anomaly.

CAN_INTERFACE=python-can
CAN_BUSTYPE=socketcan
CAN_CHANNEL=can0
CAN_BITRATE=500000

MONITOR_AUTOSTART=true
SIMULATOR_AUTOSTART=false

# Widen the allowlist to your vehicle's real identifier set before relying on
# the identifier-anomaly detector.
ALLOWED_CAN_IDS=0x100,0x200,0x300,0x400,0x500,0x600,0x700,0x7DF,0x7E0,0x7E8

# A real powertrain bus is busier than the simulator; start permissive and
# tighten once you have measured the vehicle's baseline load.
FLOOD_THRESHOLD=2500
PER_ID_FLOOD_THRESHOLD=800
