# Low noise - for long unattended runs.
#
# Only unambiguous attacks are reported, and repeats are collapsed hard so the
# event table stays readable over hours. Raw traffic recording is off: security
# events are still stored in full.

FLOOD_THRESHOLD=1200
FLOOD_SUSPICIOUS_RATIO=0.85
FLOOD_CRITICAL_MULTIPLIER=2.5
PER_ID_FLOOD_THRESHOLD=400

FAKE_SPEED_THRESHOLD=250
FAKE_SPEED_SUSPICIOUS_THRESHOLD=180
FAKE_SPEED_MAX_ACCELERATION=25

ID_ANOMALY_ESCALATION_COUNT=20
ID_ANOMALY_WINDOW_SECONDS=5

FREQUENCY_FAST_RATIO=4.0
FREQUENCY_ATTACK_RATIO=8.0
FREQUENCY_SLOW_RATIO=4.0
FREQUENCY_MIN_SAMPLES=24

DETECTION_EVENT_COOLDOWN_SECONDS=30

# Storing every frame for days is rarely worth the disk; events are what matter.
PERSIST_CAN_MESSAGES=false
RETENTION_DAYS=30
RETENTION_MAX_SECURITY_EVENTS=200000
